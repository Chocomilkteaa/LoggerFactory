{
    "name": "@chocomilktea/logger-factory",
    "version": "0.0.1-dev.6",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.18.0",
    "exports": {
        "./browser": "./dist/browser/index.js",
        "./node": "./dist/node/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "lint:check": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "test": "vitest run --config vitest.config.ts",
        "test:node:unit": "vitest run --config vitest.config.ts --project node:unit",
        "test:node:integration": "vitest run --config vitest.config.ts --project node:integration",
        "test:browser": "vitest run --config vitest.config.ts --project browser",
        "type:check": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json"
    },
    "devDependencies": {
        "@chocomilktea/config-store": "0.0.1-dev.13",
        "@types/fast-redact": "^3.0.4",
        "@types/node": "^26.3.0",
        "@vitest/browser-playwright": "^4.1.11",
        "eslint": "^10.9.0",
        "jiti": "^2.7.0",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "thread-stream": "^4.2.0",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "fast-redact": "^3.5.0",
        "pino": "^10.3.1",
        "pino-abstract-transport": "^3.0.0"
    }
}