{
  "name": "@chocomilktea/logger-factory",
  "version": "0.0.1-dev.13",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./browser": "./dist/browser/index.js",
    "./node": "./dist/node/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.config.ts --project browser",
    "test:node:integration": "vitest run --config vitest.config.ts --project node:integration",
    "test:node:unit": "vitest run --config vitest.config.ts --project node:unit",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "fast-redact": "^3.5.0",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@chocomilktea/config-store": "0.0.1-dev.30",
    "@types/fast-redact": "^3.0.4",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "thread-stream": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
